      "label": {
        "en": "Visible conjunction tonight",
        "fr": "Conjonction visible ce soir"
      },
      "description": {
        "en": "At dusk on the night of a close approach you can see.",
        "fr": "Au crépuscule de la nuit d'un rapprochement observable."
      },
      "fields": [
        {
          "key": "involves_moon",
          "type": "select",
          "label": {
            "en": "With the Moon",
            "fr": "Avec la Lune"
          },
          "required": false,
          "options": [
            {
              "value": "yes",
              "label": {
