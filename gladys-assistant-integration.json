{
  "manifest_version": 1,
  "type": "device",
  "name": "Astronomie",
  "description": {
    "en": "Eclipses, planets, meteor showers, observing nights, seasons and aurora forecasts for your home.",
    "fr": "Éclipses, planètes, étoiles filantes, nuit d'observation, saisons et aurores pour votre maison."
  },
  "version": "0.1.0",
  "docker_image": "ghcr.io/guim31/gladys-astronomy:0.1.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-astronomy/main/cover.png",
  "categories": ["environment", "services"],
  "transports": ["cloud"],
  "location": true,
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "How it works",
        "fr": "Fonctionnement"
      },
      "description": {
        "en": "Everything is computed locally from the coordinates of your Gladys house (Settings > Houses): eclipses, planets, meteor showers, twilights, seasons. The only outgoing connection is the NOAA space weather service for the aurora forecast, and it can be turned off. Times are shown in the Gladys timezone (Settings > System).",
        "fr": "Tout est calculé localement à partir des coordonnées de votre maison Gladys (Paramètres > Maisons) : éclipses, planètes, étoiles filantes, crépuscules, saisons. La seule connexion sortante est le service de météo spatiale de la NOAA pour la prévision d'aurores, et elle peut être désactivée. Les heures sont affichées dans le fuseau horaire de Gladys (Paramètres > Système)."
      },
      "links": [
        {
          "url": "https://www.swpc.noaa.gov/products/planetary-k-index",
          "label": {
            "en": "NOAA planetary K-index",
            "fr": "Indice K planétaire NOAA"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "display": "radio",
      "label": {
        "en": "Language of the texts",
        "fr": "Langue des textes"
      },
      "description": {
        "en": "Language of the sensor names and of the text values. Names are set when a device is created: to rename them after a change, delete and re-add the device.",
        "fr": "Langue des noms de capteurs et des valeurs textuelles. Les noms sont fixés à la création d'un appareil : pour les renommer après un changement, supprimez puis rajoutez l'appareil."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français"
          }
        },
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais"
          }
        }
      ]
    },
    {
      "key": "refresh_minutes",
      "type": "number",
      "label": {
        "en": "Refresh of countdowns (min)",
        "fr": "Rafraîchissement des comptes à rebours (min)"
      },
      "description": {
        "en": "Minutes between two updates of the countdowns, flags and instantaneous sky quality. Rare events are recomputed daily at 03:00, the night every 30 minutes.",
        "fr": "Minutes entre deux mises à jour des comptes à rebours, drapeaux et qualité instantanée du ciel. Les événements rares sont recalculés chaque jour à 03:00, la nuit toutes les 30 minutes."
      },
      "required": false,
      "default": 5,
      "min": 1,
      "max": 30
    },
    {
      "key": "conjunction_lookahead_days",
      "type": "number",
      "label": {
        "en": "Conjunction search window (days)",
        "fr": "Fenêtre de recherche des conjonctions (jours)"
      },
      "required": false,
      "default": 90,
      "min": 14,
      "max": 180
    },
    {
      "key": "conjunction_max_separation",
      "type": "number",
      "label": {
        "en": "Conjunction: maximum separation (°)",
        "fr": "Conjonction : séparation maximale (°)"
      },
      "description": {
        "en": "Two bodies closer than this angle count as a conjunction. The full Moon is 0.5° wide.",
        "fr": "Deux astres plus proches que cet angle forment une conjonction. La pleine Lune fait 0,5° de large."
      },
      "required": false,
      "default": 3,
      "min": 0.5,
      "max": 10
    },
    {
      "key": "meteor_min_zhr",
      "type": "number",
      "label": {
        "en": "Meteor showers: minimum ZHR",
        "fr": "Étoiles filantes : ZHR minimal"
      },
      "description": {
        "en": "Showers with a lower hourly rate are ignored (10 keeps the Draconids, Leonids and Ursids; 50 keeps only the big three).",
        "fr": "Les pluies à taux horaire inférieur sont ignorées (10 garde les Draconides, Léonides et Ursides ; 50 ne garde que les trois grandes)."
      },
      "required": false,
      "default": 10,
      "min": 0,
      "max": 150
    },
    {
      "key": "moon_max_illumination",
      "type": "number",
      "label": {
        "en": "Moonless window: maximum illumination (%)",
        "fr": "Fenêtre sans Lune : illumination maximale (%)"
      },
      "description": {
        "en": "A Moon thinner than this does not spoil the dark window.",
        "fr": "Une Lune plus fine que cela ne gâche pas la fenêtre de ciel noir."
      },
      "required": false,
      "default": 30,
      "min": 0,
      "max": 100
    },
    {
      "key": "bortle",
      "type": "number",
      "label": {
        "en": "Bortle class of your sky (0 = ignore)",
        "fr": "Classe de Bortle de votre ciel (0 = ignorer)"
      },
      "description": {
        "en": "Light pollution, 1 (pristine) to 9 (city center); lowers the sky quality score accordingly.",
        "fr": "Pollution lumineuse, 1 (ciel pur) à 9 (centre-ville) ; abaisse d'autant le score de qualité du ciel."
      },
      "required": false,
      "default": 0,
      "min": 0,
      "max": 9
    },
    {
      "key": "aurora_enabled",
      "type": "boolean",
      "label": {
        "en": "Aurora forecast (NOAA)",
        "fr": "Prévision d'aurores (NOAA)"
      },
      "description": {
        "en": "Publishes the Aurora device from the NOAA planetary Kp index, refreshed every 30 minutes. Turn off to keep the integration fully offline.",
        "fr": "Publie l'appareil Aurores à partir de l'indice Kp planétaire de la NOAA, rafraîchi toutes les 30 minutes. Désactivez pour une intégration entièrement hors ligne."
      },
      "required": false,
      "default": true
    },
    {
      "key": "aurora_kp_alert",
      "type": "number",
      "label": {
        "en": "Aurora alert from Kp",
        "fr": "Alerte aurores à partir de Kp"
      },
      "description": {
        "en": "Kp 5 is a minor storm (aurora possible around 55° of latitude), Kp 7 reaches central France.",
        "fr": "Kp 5 est un orage mineur (aurores possibles vers 55° de latitude), Kp 7 atteint le centre de la France."
      },
      "required": false,
      "default": 5,
      "min": 3,
      "max": 9
    },
    {
      "key": "location_override",
      "type": "section",
      "label": {
        "en": "Location override",
        "fr": "Localisation manuelle"
      },
      "description": {
        "en": "Leave empty to use the coordinates of the first located Gladys house. Fill both fields to observe from somewhere else.",
        "fr": "Laissez vide pour utiliser les coordonnées de la première maison Gladys localisée. Remplissez les deux champs pour observer depuis un autre lieu."
      }
    },
    {
      "key": "latitude",
      "type": "number",
      "label": {
        "en": "Latitude (°)",
        "fr": "Latitude (°)"
      },
      "required": false,
      "min": -90,
      "max": 90
    },
    {
      "key": "longitude",
      "type": "number",
      "label": {
        "en": "Longitude (°)",
        "fr": "Longitude (°)"
      },
      "required": false,
      "min": -180,
      "max": 180
    },
    {
      "key": "elevation",
      "type": "number",
      "label": {
        "en": "Elevation (m)",
        "fr": "Altitude (m)"
      },
      "required": false,
      "default": 0,
      "min": 0,
      "max": 5000
    }
  ],
  "actions": [
    {
      "key": "recompute_now",
      "label": {
        "en": "Recompute now",
        "fr": "Recalculer maintenant"
      },
      "timeout_seconds": 60
    },
    {
      "key": "test_noaa",
      "label": {
        "en": "Test the NOAA service",
        "fr": "Tester le service NOAA"
      },
      "timeout_seconds": 30
    }
  ],
  "widgets": [
    {
      "key": "astro_tonight",
      "label": {
        "en": "Tonight's sky",
        "fr": "Cette nuit"
      },
      "description": {
        "en": "Sky quality through the night, moonless window and visible planets.",
        "fr": "Qualité du ciel sur la nuit, fenêtre sans Lune et planètes visibles."
      },
      "icon": "moon"
    },
    {
      "key": "astro_agenda",
      "label": {
        "en": "Sky agenda",
        "fr": "Agenda du ciel"
      },
      "description": {
        "en": "The next eclipses, meteor peaks, conjunctions and seasons.",
        "fr": "Prochaines éclipses, étoiles filantes, conjonctions et saisons."
      },
      "icon": "calendar",
      "settings": [
        {
          "key": "categories",
          "type": "multi_select",
          "label": {
            "en": "Events to show",
            "fr": "Événements à afficher"
          },
          "description": {
            "en": "Leave empty to show everything.",
            "fr": "Laissez vide pour tout afficher."
          },
          "required": false,
          "options": [
            {
              "value": "eclipses",
              "label": {
                "en": "Eclipses",
                "fr": "Éclipses"
              }
            },
            {
              "value": "meteors",
              "label": {
                "en": "Meteor showers",
                "fr": "Étoiles filantes"
              }
            },
            {
              "value": "conjunctions",
              "label": {
                "en": "Conjunctions",
                "fr": "Conjonctions"
              }
            },
            {
              "value": "planets",
              "label": {
                "en": "Oppositions and elongations",
                "fr": "Oppositions et élongations"
              }
            },
            {
              "value": "seasons",
              "label": {
                "en": "Seasons and orbit",
                "fr": "Saisons et orbite"
              }
            },
            {
              "value": "transits",
              "label": {
                "en": "Transits",
                "fr": "Transits"
              }
            }
          ]
        },
        {
          "key": "horizon_days",
          "type": "select",
          "label": {
            "en": "Period",
            "fr": "Période"
          },
          "required": false,
          "default": "90",
          "options": [
            {
              "value": "30",
              "label": {
                "en": "30 days",
                "fr": "30 jours"
              }
            },
            {
              "value": "90",
              "label": {
                "en": "3 months",
                "fr": "3 mois"
              }
            },
            {
              "value": "365",
              "label": {
                "en": "1 year",
                "fr": "1 an"
              }
            }
          ]
        }
      ]
    },
    {
      "key": "astro_aurora",
      "label": {
        "en": "Aurora",
        "fr": "Aurores"
      },
      "description": {
        "en": "NOAA Kp index, observed and forecast, with the alert level.",
        "fr": "Indice Kp de la NOAA, observé et prévu, avec le niveau d'alerte."
      },
      "icon": "activity"
    },
    {
      "key": "astro_eclipse",
      "label": {
        "en": "Next eclipse",
        "fr": "Prochaine éclipse"
      },
      "description": {
        "en": "Countdown and phases of the next eclipse visible from home.",
        "fr": "Compte à rebours et phases de la prochaine éclipse visible de chez vous."
      },
      "icon": "sun",
      "settings": [
        {
          "key": "kind",
          "type": "select",
          "label": {
            "en": "Eclipse",
            "fr": "Éclipse"
          },
          "required": false,
          "default": "any",
          "options": [
            {
              "value": "any",
              "label": {
                "en": "The next one",
                "fr": "La prochaine"
              }
            },
            {
              "value": "solar",
              "label": {
                "en": "Solar",
                "fr": "Solaire"
              }
            },
            {
              "value": "lunar",
              "label": {
                "en": "Lunar",
                "fr": "Lunaire"
              }
            }
          ]
        }
      ]
    }
  ],
  "scene_triggers": [
    {
      "key": "eclipse_phase",
      "label": {
        "en": "Eclipse begins or peaks",
        "fr": "Début ou maximum d'éclipse"
      },
      "description": {
        "en": "An eclipse visible from home starts, or reaches its maximum.",
        "fr": "Une éclipse visible de chez vous commence, ou atteint son maximum."
      },
      "fields": [
        {
          "key": "body",
          "type": "multi_select",
          "label": {
            "en": "Eclipse of",
            "fr": "Éclipse de"
          },
          "required": false,
          "options": [
            {
              "value": "sun",
              "label": {
                "en": "the Sun",
                "fr": "Soleil"
              }
            },
            {
              "value": "moon",
              "label": {
                "en": "the Moon",
                "fr": "Lune"
              }
            }
          ]
        },
        {
          "key": "phase",
          "type": "select",
          "label": {
            "en": "Moment",
            "fr": "Moment"
          },
          "required": false,
          "options": [
            {
              "value": "begin",
              "label": {
                "en": "Beginning",
                "fr": "Début"
              }
            },
            {
              "value": "peak",
              "label": {
                "en": "Maximum",
                "fr": "Maximum"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "body",
          "type": "string",
          "label": {
            "en": "Sun or Moon",
            "fr": "Soleil ou Lune"
          }
        },
        {
          "key": "kind",
          "type": "string",
          "label": {
            "en": "Kind",
            "fr": "Type"
          }
        },
        {
          "key": "phase",
          "type": "string",
          "label": {
            "en": "Moment",
            "fr": "Moment"
          }
        },
        {
          "key": "obscuration",
          "type": "number",
          "label": {
            "en": "Obscuration (%)",
            "fr": "Obscuration (%)"
          }
        },
        {
          "key": "peak_time",
          "type": "string",
          "label": {
            "en": "Maximum time",
            "fr": "Heure du maximum"
          }
        },
        {
          "key": "end_time",
          "type": "string",
          "label": {
            "en": "End time",
            "fr": "Heure de fin"
          }
        },
        {
          "key": "description",
          "type": "string",
          "label": {
            "en": "Description",
            "fr": "Description"
          }
        }
      ]
    },
    {
      "key": "dark_window_starting",
      "label": {
        "en": "Moonless dark sky begins",
        "fr": "Début du ciel noir sans Lune"
      },
      "description": {
        "en": "The darkest, moonless part of the night starts.",
        "fr": "La partie la plus noire de la nuit, sans Lune, commence."
      },
      "variables": [
        {
          "key": "duration_minutes",
          "type": "number",
          "label": {
            "en": "Duration (min)",
            "fr": "Durée (min)"
          }
        },
        {
          "key": "end_time",
          "type": "string",
          "label": {
            "en": "End time",
            "fr": "Heure de fin"
          }
        },
        {
          "key": "best_score",
          "type": "number",
          "label": {
            "en": "Best sky score",
            "fr": "Meilleur score du ciel"
          }
        },
        {
          "key": "summary",
          "type": "string",
          "label": {
            "en": "Night summary",
            "fr": "Résumé de la nuit"
          }
        }
      ]
    },
    {
      "key": "meteor_peak_night",
      "label": {
        "en": "Meteor shower peak tonight",
        "fr": "Pic d'étoiles filantes ce soir"
      },
      "description": {
        "en": "At dusk on the night of a meteor shower peak.",
        "fr": "Au crépuscule de la nuit d'un pic d'étoiles filantes."
      },
      "fields": [
        {
          "key": "shower",
          "type": "multi_select",
          "label": {
            "en": "Shower",
            "fr": "Pluie"
          },
          "required": false,
