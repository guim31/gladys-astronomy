              }
            },
            {
              "value": "URS",
              "label": {
                "en": "Ursids",
                "fr": "Ursides"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "shower",
          "type": "string",
          "label": {
            "en": "Shower code",
            "fr": "Code de la pluie"
          }
        },
        {
          "key": "name",
